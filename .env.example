# Public URL of the site, used for canonical links, Open Graph tags, robots.txt and sitemap.xml.
# On Vercel this falls back to your production domain automatically, but setting it is recommended.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Scans allowed per IP per window (defaults: 10 scans per 300 seconds).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=300
